@page "/client/dashboard"
@attribute [Authorize(Roles = "Client")]
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<div class="container my-4 my-md-5 px-3" style="max-width: 450px;">
    <div class="card shadow-lg border-0 text-center" style="border-radius: 20px;">
        
        <div class="card-header bg-primary text-white py-3 py-md-4" style="border-top-left-radius: 20px; border-top-right-radius: 20px;">
            <i class="bi bi-qr-code-scan display-6 display-md-5"></i>
            <h4 class="fw-bold mt-2 mb-0 fs-5 fs-md-3">Ваш Электронный Пропуск</h4>
        </div>
        
        <div class="card-body p-3 p-sm-4 p-md-5">
            <h6 class="text-secondary mb-1 fs-6 text-opacity-75">Добро пожаловать,</h6>
            <h4 class="fw-bold text-dark mb-4 text-break fs-4 fs-md-2">@ClientLogin</h4>

            <div class="p-2 p-sm-3 bg-light d-inline-block rounded shadow-sm mb-4 border">
                @if (!string.IsNullOrEmpty(ClientIdString))
                {
                    <img src="https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=@ClientIdString" 
                         alt="QR Code Pass" 
                         class="img-fluid d-block mx-auto" 
                         style="width: 100%; max-width: 220px; height: auto; min-width: 150px;" />
                }
                else
                {
                    <div class="spinner-border text-primary my-4" role="status">
                        <span class="visually-hidden">Генерация...</span>
                    </div>
                }
            </div>

            <p class="text-muted mb-0 mx-auto fs-7 px-2" style="max-width: 320px; font-size: 0.85rem;">
                Покажите этот QR-код на рецепции или сканеру на турникете для фиксации визита.
            </p>

            <hr class="my-4" />

            <a href="api/auth/logout" class="btn btn-outline-danger w-100 btn-md btn-lg-hover shadow-sm fw-semibold py-2">
                <i class="bi bi-box-arrow-right me-2"></i>Выйти из профиля
            </a>
        </div>
    </div>
</div>

@code {
    private string ClientLogin { get; set; } = "Загрузка...";
    private string ClientIdString { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity is not { IsAuthenticated: true })
        {
            Navigation.NavigateTo("/", true);
            return;
        }

        ClientLogin = user.Identity.Name ?? "Клиент";
        ClientIdString = user.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "NoID";
    }
}