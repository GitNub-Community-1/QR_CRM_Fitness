@attribute [Authorize(Roles = "Admin, Moderator")]
@inject IClientManagerService ClientService
@inject ITrainerService TrainerService
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Authorization
@using TestQRApp.Models.DTOs
@using TestQRApp.Services.interfaces
@rendermode InteractiveServer
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<div class="container-fluid px-0">
    
    @if (!string.IsNullOrEmpty(DisplaySuccess))
    {
        <div class="alert alert-success alert-dismissible fade show shadow position-fixed top-0 end-0 m-3" role="alert" style="z-index: 1060;">
            <i class="bi bi-check-circle-fill me-2"></i><strong>Успех:</strong> @DisplaySuccess
            <button type="button" class="btn-close" @onclick="() => DisplaySuccess = null"></button>
        </div>
    }

    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <h2 class="fw-bold text-dark mb-0">Управление Клиентами</h2>
            <p class="text-muted">Регистрация, выдача доступов и просмотр QR-пропусков</p>
        </div>
        <button class="btn btn-success shadow-sm py-2" @onclick="OpenAddModal">
            <i class="bi bi-person-plus-fill me-2"></i>Зарегистрировать клиента
        </button>
    </div>

    <div class="card shadow-sm border-0 rounded-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-4">ФИО</th>
                        <th>Логин</th>
                        <th>Телефон</th>
                        <th>Статус</th>
                        <th class="text-end pe-4">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @if (ClientList == null)
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4">
                                <div class="spinner-border text-success" role="status"></div>
                            </td>
                        </tr>
                    }
                    else if (!ClientList.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">Клиенты не найдены. Создайте первого!</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var client in ClientList)
                        {
                            <tr>
                                <td class="fw-bold ps-4 text-dark">@client.FullName</td>
                                <td><code class="text-secondary">@client.Login</code></td>
                                <td>@client.PhoneNumber</td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Активен</span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group shadow-sm">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenInfoModal(client.Id)" title="Инфо и QR-код">
                                            <i class="bi bi-qr-code-scan"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => OpenDeleteModal(client.Id, client.FullName)" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (ShowModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); z-index: 1050;" role="dialog">
        <div class="modal-dialog modal-dialog-centered @(ModalType == "info" ? "modal-md" : "modal-lg")">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title fw-bold">@ModalTitle</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                
                <div class="modal-body p-4">
                    @if (ModalType == "delete")
                    {
                        <p class="fs-5 text-center">Вы действительно хотите удалить клиента <strong class="text-danger">@TargetClientName</strong>?</p>
                    }
                    else if (ModalType == "info" && DetailModel != null)
                    {
                        <div class="text-center mb-4">
                            <div class="p-3 bg-light d-inline-block rounded border shadow-sm">
                                <img src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=@DetailModel.Id" alt="QR Pass" style="width:180px; height:180px;" />
                            </div>
                            <h4 class="fw-bold text-dark mt-3 mb-1">@DetailModel.LastName @DetailModel.FirstName</h4>
                            <span class="badge bg-dark">ID: @DetailModel.Id</span>
                        </div>
                        <hr/>
                        <div class="row g-2 text-start">
                            <div class="col-6"><span class="text-muted small d-block">Логин:</span><strong>@DetailModel.Login</strong></div>
                            <div class="col-6"><span class="text-muted small d-block">Телефон:</span><strong>@DetailModel.PhoneNumber</strong></div>
                            
                            <div class="col-6 mt-2">
                                <span class="text-muted small d-block">Абонемент:</span>
                                <span class="badge bg-info text-dark">
                                    @((DetailModel.SubscriptionName) ?? "Нет абонемента")
                                </span>
                            </div>
                            <div class="col-6 mt-2">
                                <span class="text-muted small d-block">Статус визитов:</span>
                                <strong>@((DetailModel.RemainingVisitsStatus) ?? "0")</strong>
                            </div>
                        </div>
                    }
                    else if (ModalType == "add")
                    {
                        <form action="/api/staff/create-client" method="post" enctype="application/x-www-form-urlencoded">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label small fw-semibold">Имя</label>
                                    <input type="text" class="form-control" name="FirstName" placeholder="Иван" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label small fw-semibold">Фамилия</label>
                                    <input type="text" class="form-control" name="LastName" placeholder="Иванов" required />
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <label class="form-label small fw-semibold">Возраст</label>
                                    <input type="number" class="form-control" name="Age" min="1" max="120" value="20" required />
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label small fw-semibold">Пол</label>
                                    <select class="form-select" name="Gender">
                                        <option value="0">Мужской</option>
                                        <option value="1">Женский</option>
                                    </select>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <label class="form-label small fw-semibold">Назначить Тренера</label>
                                    <select class="form-select" name="TrainerId">
                                        <option value="">Без тренера</option>
                                        @if (AvailableTrainers != null)
                                        {
                                            @foreach (var trainer in AvailableTrainers)
                                            {
                                                <option value="@trainer.Id">@trainer.FullName</option>
                                            }
                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Номер телефона</label>
                                <input type="text" class="form-control" name="PhoneNumber" placeholder="+7..." required />
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label small fw-semibold">Логин</label>
                                    <input type="text" class="form-control" name="Login" placeholder="Логин" required />
                                </div>
                                <div class="col-md-6 mb-4">
                                    <label class="form-label small fw-semibold">Пароль</label>
                                    <input type="password" class="form-control" name="Password" placeholder="Минимум 6 символов" required />
                                </div>
                            </div>
                            <div class="modal-footer bg-light px-0 pb-0 pt-3">
                                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Отмена</button>
                                <button type="submit" class="btn btn-success fw-bold px-4">Создать клиента</button>
                            </div>
                        </form>
                    }
                </div>
                
                @if (ModalType != "add")
                {
                    <div class="modal-footer bg-light">
                        <button type="button" class="btn btn-secondary" @onclick="CloseModal">Закрыть</button>
                        @if (ModalType == "delete")
                        {
                            <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Да, удалить</button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<ClientListDto>? ClientList { get; set; }
    private List<TrainerDto>? AvailableTrainers { get; set; }
    
    private bool ShowModal { get; set; }
    private string ModalType { get; set; } = "";
    private string ModalTitle { get; set; } = "";
    
    private Guid _targetClientId;
    private string TargetClientName { get; set; } = "";
    private ClientDetailDto? DetailModel { get; set; }
    
    private string? DisplaySuccess { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        var pagedResult = await ClientService.GetClientsAsync("", 1, 50);
        ClientList = pagedResult.Items;
        AvailableTrainers = await TrainerService.GetAllTrainersAsync();
    }

    protected override void OnParametersSet()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (queryParams.TryGetValue("success", out var successVal))
        {
            DisplaySuccess = successVal;
            Navigation.NavigateTo("/trainers", replace: true);
        }
    }

    private void OpenAddModal()
    {
        ModalType = "add";
        ModalTitle = "Регистрация нового клиента";
        ShowModal = true;
    }

    private async Task OpenInfoModal(Guid id)
    {
        ModalType = "info";
        ModalTitle = "Профиль и QR пропуск";
        DetailModel = await ClientService.GetClientDetailAsync(id);
        ShowModal = true;
    }

    private void OpenDeleteModal(Guid id, string name)
    {
        ModalType = "delete";
        ModalTitle = "Удаление аккаунта";
        _targetClientId = id;
        TargetClientName = name;
        ShowModal = true;
    }

    private void CloseModal()
    {
        ShowModal = false;
        DetailModel = null;
    }

    private async Task ConfirmDelete()
    {
        System.Diagnostics.Debug.WriteLine($"Удаление клиента с ID: {_targetClientId}");
        
        // Когда добавишь метод удаления в сервис, раскомментируй строку ниже:
        // await ClientService.DeleteClientAsync(_targetClientId);
        
        CloseModal();
        await LoadData();
    }
}