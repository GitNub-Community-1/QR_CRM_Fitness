@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<Router AppAssembly="@typeof(Program).Assembly" AdditionalAssemblies="new[] { typeof(Program).Assembly }">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" @rendermode="InteractiveServer">
            <NotAuthorized>
                <div class="text-center py-5">
                    <p class="text-danger fw-bold">У вас нет доступа к этой странице.</p>
                    <a href="/" class="btn btn-primary btn-sm">На главную</a>
                </div>
            </NotAuthorized>
            <Authorizing>
                <div class="d-flex justify-content-center align-items-center vh-100">
                    <div class="spinner-border text-success" role="status"></div>
                </div>
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <LayoutView Layout="@typeof(Layout.MainLayout)">
            <p role="alert">Извини, по этому адресу ничего не найдено.</p>
        </LayoutView>
    </NotFound>
</Router>