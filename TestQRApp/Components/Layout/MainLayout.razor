@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow mb-4">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold text-success" href="/">
            <i class="bi bi-lightning-charge-fill me-2"></i>FitPass CRM
        </a>
        
        <AuthorizeView Context="mainContext">
            <Authorized>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 fs-6 fw-normal">
                        
                        <AuthorizeView Roles="Admin, Moderator" Context="staffContext">
                            <Authorized>
                                <li class="nav-item me-2">
                                    <NavLink class="nav-link text-white-50" href="/trainers" Match="NavLinkMatch.Prefix">
                                        <i class="bi bi-people-fill me-1"></i> Клиенты
                                    </NavLink>
                                </li>
                                <li class="nav-item me-2">
                                    <NavLink class="nav-link text-white-50" href="/trainers-management" Match="NavLinkMatch.Prefix">
                                        <i class="bi bi-person-badge-fill me-1"></i> Тренеры
                                    </NavLink>
                                </li>
                                <li class="nav-item me-2">
                                    <NavLink class="nav-link" href="scan">
                                        <span class="bi bi-qr-code-scan me-2"></span> Сканер Входа
                                    </NavLink>
                                </li>
                            </Authorized>
                        </AuthorizeView>

                        <AuthorizeView Roles="Admin" Context="adminContext">
                            <Authorized>
                                <li class="nav-item me-2">
                                    <NavLink class="nav-link text-white-50" href="/subscriptions" Match="NavLinkMatch.Prefix">
                                        <i class="bi bi-card-checklist me-1"></i> Тарифы
                                    </NavLink>
                                </li>
                                <li class="nav-item me-2">
                                    <NavLink class="nav-link text-white-50" href="/staff-management" Match="NavLinkMatch.Prefix">
                                        <i class="bi bi-shield-lock-fill me-1"></i> Персонал
                                    </NavLink>
                                </li>
                                <li class="nav-item me-2">
                                    <NavLink class="nav-link" href="scan">
                                        <span class="bi bi-qr-code-scan me-2"></span> Сканер Входа
                                    </NavLink>
                                </li>
                            </Authorized>
                        </AuthorizeView>

                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <span class="text-white-50 small">
                            <i class="bi bi-person-circle me-1"></i> @mainContext.User.Identity?.Name
                        </span>
                        <a href="api/auth/logout" class="btn btn-outline-danger btn-sm shadow-sm">
                            <i class="bi bi-box-arrow-right me-1"></i> Выйти
                        </a>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="ms-auto">
                    <a href="/login" class="btn btn-success btn-sm px-3 fw-bold">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Войти
                    </a>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</nav>

<main class="container px-3 px-md-4">
    <article class="content">
        @Body
    </article>
</main>

<div id="blazor-error-ui" data-nosnippet>
    Произошла ошибка.
    <a href="." class="reload">Перезагрузить</a>
    <span class="dismiss">🗙</span>
</div>